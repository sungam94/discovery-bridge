# Copy to .env (gitignored, chmod 600). Docker Compose reads it for the variables in docker-compose.yml, and
# the bridge container gets it as its environment.

# --- Secrets (required) ---
# Music Assistant long-lived token: MA > Settings > Profile > Long-lived tokens.
MA_TOKEN=
# Value of the sp_dc cookie of open.spotify.com, logged in with the Spotify account whose taste is used.
SPOTIFY_SP_DC=
# Password of the status page.
STATUS_PASSWORD=
# Random string for the status page sessions, for example: openssl rand -hex 32
SESSION_SECRET=

# --- Optional ---
# Random string shared by the bridge and the feedback adapter (openssl rand -hex 32). Empty: the feedback
# queue does not run.
FEEDBACK_API_TOKEN=
# Last.fm API key for artist biographies on MA artist pages. Empty: MusicBrainz and Wikipedia only.
LASTFM_API_KEY=

# --- Server ---
# IANA timezone of every container and the default of the timezone setting in config.yaml.
TZ=UTC
# Host folder for the second backup copy, mounted at /backup-copy. Ideally on another disk.
BACKUP_COPY_DIR=./backup-copy
# Host folder for the optional health.json (health_file in config.yaml), mounted at /health. See docs/WATCHDOG.md.
HEALTH_DIR=./health
# Optional services: feedback (plays on your Spotify account, x86_64 only) and analysis (sound analysis,
# x86_64 only), for example COMPOSE_PROFILES=feedback,analysis. Empty: the bridge only.
COMPOSE_PROFILES=
